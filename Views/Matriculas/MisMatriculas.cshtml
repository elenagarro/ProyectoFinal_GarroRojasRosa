@model IEnumerable<ProyectoFinal_GarroRojasRosa.Models.Matricula>

@{
    ViewData["Title"] = "Mis Matrículas";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Mis Matrículas</h3>
    </div>

    <div class="card-body">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensaje"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No tiene matrículas registradas actualmente.
            </div>
        }
        else
        {
            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Curso</th>
                        <th>Carrera</th>
                        <th>Docente</th>
                        <th>Fecha de Matrícula</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Curso?.Codigo
                            </td>

                            <td>
                                @item.Curso?.Nombre
                            </td>

                            <td>
                                @item.Curso?.Carrera?.Nombre
                            </td>

                            <td>
                                @if (item.Curso?.Docente != null)
                                {
                                    @item.Curso.Docente.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin docente asignado
                                    </span>
                                }
                            </td>

                            <td>
                                @item.FechaMatricula.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Cancelada
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.Estado)
                                {
                                    <form asp-action="Cancelar"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.IdMatricula" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('¿Está seguro de cancelar esta matrícula?');">

                                            Cancelar

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin acciones
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

        <div class="mt-3">

            <a asp-action="CursosDisponibles"
               class="btn btn-primary">
                Ver cursos disponibles
            </a>

        </div>

    </div>

</div>